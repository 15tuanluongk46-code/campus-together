HOST=127.0.0.1
PORT=2567
# Pilot admission defaults (positive safe integers; validated before startup).
CAMPUS_MAX_ROOMS=32
CAMPUS_CREATE_BURST=6
CAMPUS_CREATE_REFILL_MS=10000
CAMPUS_MAX_IPS=4096
CAMPUS_IP_IDLE_MS=600000
# TCP always uses the peer IP; forwarded headers never grant it a separate budget.
# Optional dedicated Cloudflare Unix origin. Precreate an absolute, user-owned
# directory mode 0700; app binds origin.sock mode 0600. See docs/cloudflare.md.
# CAMPUS_CLOUDFLARE_SOCKET_DIR=/absolute/private/path
# Client defaults to its own origin (Vite proxies in development).
# Set at client build time only when the server is on another origin:
# VITE_SERVER_URL=https://your-authorized-server.example
# Vite accepts this via process environment or apps/client/.env.local at build time.
# Root .env is not automatically loaded by the server. Example:
# HOST=0.0.0.0 PORT=2567 npm start
# Same-origin deployment is recommended; leave VITE_SERVER_URL unset.
# deploy/Caddyfile uses CAMPUS_DOMAIN at proxy startup, e.g. campus.example.org.
